# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
APP_NAME=Ecosysval Python API
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# ==========================================
# CONEXIÓN CON ECOSYSVAL BACKEND (NestJS)
# ==========================================
ECOSYSVAL_API_URL=http://localhost:3000

# ==========================================
# BASE DE DATOS (Supabase - misma que Ecosysval)
# ==========================================
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# ==========================================
# APIs EXTERNAS (Sistema Inteligente Económico)
# ==========================================
# Banxico API (tipo de cambio, inflación)
BANXICO_TOKEN=tu_token_de_banxico

# INEGI API (datos económicos México)
INEGI_TOKEN=tu_token_de_inegi

# ==========================================
# SEGURIDAD
# ==========================================
JWT_SECRET=cambia_esta_clave_por_una_secreta